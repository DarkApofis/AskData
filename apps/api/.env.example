# Copy to .env and fill in locally. Never commit real values.
# The app reads environment variables only; load this file with:
#   uv run --env-file .env uvicorn askdata_api.main:app --reload

# Required. LLM providers (free tiers). The API refuses to start without both.
GEMINI_API_KEY=
GROQ_API_KEY=
# Required. Comma-separated exact origins (scheme://host[:port]), no wildcard.
# Production requires https; development also allows http://localhost / 127.0.0.1.
ALLOWED_ORIGINS=

# Optional (defaults shown).
# APP_ENV=production            # production | development
# MAX_BODY_BYTES=65536
# REQUEST_TIMEOUT_SECONDS=20
# GEMINI_MODEL=gemini-3.5-flash-lite
# LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
